{
  "$defs": {
    "BenchmarkArtifact": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Artifact Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "evidence_boundary": {
          "minLength": 1,
          "title": "Evidence Boundary",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Kind",
          "type": "string"
        },
        "relative_path": {
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        },
        "status": {
          "minLength": 1,
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "relative_path",
        "content_hash",
        "status",
        "source_refs",
        "evidence_boundary"
      ],
      "title": "BenchmarkArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_set_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Artifact Set Hash",
      "type": "string"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/BenchmarkArtifact"
      },
      "minItems": 1,
      "title": "Artifacts",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "engine_qualification_runs": {
      "minimum": 0,
      "title": "Engine Qualification Runs",
      "type": "integer"
    },
    "evidence_summary_content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Evidence Summary Content Hash",
      "type": "string"
    },
    "evidence_summary_ref": {
      "minLength": 1,
      "title": "Evidence Summary Ref",
      "type": "string"
    },
    "historical_replays": {
      "minimum": 0,
      "title": "Historical Replays",
      "type": "integer"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Limitations",
      "type": "array"
    },
    "optimization_tasks": {
      "minimum": 0,
      "title": "Optimization Tasks",
      "type": "integer"
    },
    "registry_id": {
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "title": "Registry Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "minProperties": 1,
      "title": "Status Counts",
      "type": "object"
    }
  },
  "required": [
    "registry_id",
    "created_at",
    "artifacts",
    "historical_replays",
    "optimization_tasks",
    "engine_qualification_runs",
    "status_counts",
    "evidence_summary_ref",
    "evidence_summary_content_hash",
    "artifact_set_hash",
    "limitations"
  ],
  "title": "BenchmarkRegistry",
  "type": "object"
}
