{
  "$defs": {
    "DecisionReadiness": {
      "enum": [
        "descriptive-only",
        "insufficient-evidence"
      ],
      "title": "DecisionReadiness",
      "type": "string"
    },
    "EvidenceType": {
      "enum": [
        "observed",
        "estimated",
        "causal",
        "simulated",
        "optimized",
        "proposed"
      ],
      "title": "EvidenceType",
      "type": "string"
    },
    "ScenarioScreenStatus": {
      "enum": [
        "screened",
        "insufficient-evidence",
        "failed"
      ],
      "title": "ScenarioScreenStatus",
      "type": "string"
    },
    "StandardMetric": {
      "additionalProperties": false,
      "properties": {
        "evidence_type": {
          "$ref": "#/$defs/EvidenceType"
        },
        "geographic_scope": {
          "minLength": 1,
          "title": "Geographic Scope",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        },
        "temporal_scope": {
          "minLength": 1,
          "title": "Temporal Scope",
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "id",
        "value",
        "unit",
        "evidence_type",
        "geographic_scope",
        "temporal_scope",
        "source_refs",
        "limitations"
      ],
      "title": "StandardMetric",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "analysis_mode": {
      "const": "descriptive",
      "default": "descriptive",
      "title": "Analysis Mode",
      "type": "string"
    },
    "city_id": {
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "title": "City Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "decision_readiness": {
      "$ref": "#/$defs/DecisionReadiness"
    },
    "interpretation": {
      "minLength": 1,
      "title": "Interpretation",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Limitations",
      "type": "array"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/StandardMetric"
      },
      "minItems": 1,
      "title": "Metrics",
      "type": "array"
    },
    "proposed_follow_up": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Proposed Follow Up",
      "type": "array"
    },
    "question": {
      "minLength": 1,
      "title": "Question",
      "type": "string"
    },
    "recommendation_issued": {
      "const": false,
      "default": false,
      "title": "Recommendation Issued",
      "type": "boolean"
    },
    "required_next_evidence": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Required Next Evidence",
      "type": "array"
    },
    "run_id": {
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "title": "Run Id",
      "type": "string"
    },
    "scenario_id": {
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_refs": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Refs",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/ScenarioScreenStatus"
    },
    "template_id": {
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "title": "Template Id",
      "type": "string"
    },
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "scenario_id",
    "template_id",
    "city_id",
    "created_at",
    "title",
    "question",
    "status",
    "decision_readiness",
    "source_refs",
    "metrics",
    "interpretation",
    "proposed_follow_up",
    "required_next_evidence",
    "limitations"
  ],
  "title": "StandardScenarioRun",
  "type": "object"
}
