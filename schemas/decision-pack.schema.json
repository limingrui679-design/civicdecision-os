{
  "$defs": {
    "DecisionOption": {
      "additionalProperties": false,
      "properties": {
        "binding_constraints": {
          "items": {
            "type": "string"
          },
          "title": "Binding Constraints",
          "type": "array"
        },
        "evidence_type": {
          "$ref": "#/$defs/EvidenceType"
        },
        "feasible": {
          "title": "Feasible",
          "type": "boolean"
        },
        "id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "metrics": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Metrics",
          "type": "object"
        }
      },
      "required": [
        "id",
        "label",
        "evidence_type",
        "feasible",
        "metrics",
        "limitations"
      ],
      "title": "DecisionOption",
      "type": "object"
    },
    "EvidenceItem": {
      "additionalProperties": false,
      "description": "A typed analytical statement with evidence-specific requirements.",
      "properties": {
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "constraints": {
          "items": {
            "type": "string"
          },
          "title": "Constraints",
          "type": "array"
        },
        "diagnostics": {
          "items": {
            "type": "string"
          },
          "title": "Diagnostics",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "identification_strategy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identification Strategy"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        },
        "objective": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Objective"
        },
        "scenario_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scenario Ref"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/EvidenceStatus"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "title": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/EvidenceType"
        }
      },
      "required": [
        "id",
        "type",
        "status",
        "title",
        "summary"
      ],
      "title": "EvidenceItem",
      "type": "object"
    },
    "EvidenceStatus": {
      "enum": [
        "established",
        "limited",
        "failed",
        "insufficient_evidence"
      ],
      "title": "EvidenceStatus",
      "type": "string"
    },
    "EvidenceType": {
      "enum": [
        "observed",
        "estimated",
        "causal",
        "simulated",
        "optimized",
        "proposed"
      ],
      "title": "EvidenceType",
      "type": "string"
    },
    "JsonValue": {},
    "Recommendation": {
      "additionalProperties": false,
      "properties": {
        "evidence_type": {
          "$ref": "#/$defs/EvidenceType"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "required_next_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Required Next Evidence",
          "type": "array"
        },
        "reversal_conditions": {
          "items": {
            "type": "string"
          },
          "title": "Reversal Conditions",
          "type": "array"
        },
        "selected_option_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Option Id"
        }
      },
      "required": [
        "evidence_type",
        "rationale",
        "limitations"
      ],
      "title": "Recommendation",
      "type": "object"
    },
    "Reproducibility": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Command",
          "type": "array"
        },
        "environment": {
          "additionalProperties": {
            "type": "string"
          },
          "minProperties": 1,
          "title": "Environment",
          "type": "object"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "minProperties": 1,
          "title": "Parameters",
          "type": "object"
        },
        "random_seed": {
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Random Seed",
          "type": "integer"
        },
        "software_version": {
          "minLength": 1,
          "title": "Software Version",
          "type": "string"
        },
        "source_hashes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Hashes",
          "type": "array"
        }
      },
      "required": [
        "software_version",
        "command",
        "random_seed",
        "environment",
        "parameters",
        "source_hashes"
      ],
      "title": "Reproducibility",
      "type": "object"
    },
    "ReversalOutcome": {
      "enum": [
        "reversed",
        "stable",
        "inconclusive"
      ],
      "title": "ReversalOutcome",
      "type": "string"
    },
    "ReversalTest": {
      "additionalProperties": false,
      "description": "A controlled sensitivity test that can overturn a selected option.",
      "properties": {
        "baseline_option_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Option Id"
        },
        "baseline_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            }
          ],
          "title": "Baseline Value"
        },
        "evidence_type": {
          "$ref": "#/$defs/EvidenceType"
        },
        "id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "method": {
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/ReversalOutcome"
        },
        "parameter": {
          "minLength": 1,
          "title": "Parameter",
          "type": "string"
        },
        "selected_option_id_after_test": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Option Id After Test"
        },
        "tested_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            }
          ],
          "title": "Tested Value"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "id",
        "parameter",
        "baseline_value",
        "tested_value",
        "unit",
        "outcome",
        "evidence_type",
        "method",
        "limitations"
      ],
      "title": "ReversalTest",
      "type": "object"
    },
    "RunStatus": {
      "enum": [
        "completed",
        "failed",
        "insufficient_evidence",
        "infeasible",
        "timed_out"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "SourceManifest": {
      "additionalProperties": false,
      "description": "Evidence required to identify and independently verify a downloaded artifact.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_path": {
          "minLength": 1,
          "title": "Artifact Path",
          "type": "string"
        },
        "content_hash": {
          "title": "Content Hash",
          "type": "string"
        },
        "data_url": {
          "format": "uri",
          "minLength": 1,
          "title": "Data Url",
          "type": "string"
        },
        "geographic_scope": {
          "minLength": 1,
          "title": "Geographic Scope",
          "type": "string"
        },
        "landing_url": {
          "format": "uri",
          "minLength": 1,
          "title": "Landing Url",
          "type": "string"
        },
        "license": {
          "minLength": 1,
          "title": "License",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "publisher": {
          "minLength": 1,
          "title": "Publisher",
          "type": "string"
        },
        "query": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Query",
          "type": "object"
        },
        "record_count": {
          "minimum": 0,
          "title": "Record Count",
          "type": "integer"
        },
        "response_headers": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Response Headers",
          "type": "object"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "schema_fingerprint": {
          "title": "Schema Fingerprint",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Source Id",
          "type": "string"
        },
        "temporal_scope": {
          "minLength": 1,
          "title": "Temporal Scope",
          "type": "string"
        },
        "upstream_updated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upstream Updated At"
        }
      },
      "required": [
        "source_id",
        "artifact_id",
        "name",
        "publisher",
        "landing_url",
        "data_url",
        "license",
        "retrieved_at",
        "query",
        "artifact_path",
        "content_hash",
        "record_count",
        "schema_fingerprint",
        "geographic_scope",
        "temporal_scope",
        "limitations"
      ],
      "title": "SourceManifest",
      "type": "object"
    },
    "ValueOfInformation": {
      "additionalProperties": false,
      "description": "A ranked evidence gap whose resolution could change the decision.",
      "properties": {
        "collection_action": {
          "minLength": 1,
          "title": "Collection Action",
          "type": "string"
        },
        "decision_link": {
          "minLength": 1,
          "title": "Decision Link",
          "type": "string"
        },
        "evidence_type": {
          "$ref": "#/$defs/EvidenceType",
          "default": "proposed"
        },
        "id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "priority_score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Priority Score",
          "type": "number"
        },
        "uncertainty": {
          "minLength": 1,
          "title": "Uncertainty",
          "type": "string"
        }
      },
      "required": [
        "id",
        "uncertainty",
        "decision_link",
        "collection_action",
        "priority_score",
        "limitations"
      ],
      "title": "ValueOfInformation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceItem"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "failure_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Reason"
    },
    "options": {
      "items": {
        "$ref": "#/$defs/DecisionOption"
      },
      "title": "Options",
      "type": "array"
    },
    "recommendation": {
      "$ref": "#/$defs/Recommendation"
    },
    "reproducibility": {
      "$ref": "#/$defs/Reproducibility"
    },
    "reversal_tests": {
      "items": {
        "$ref": "#/$defs/ReversalTest"
      },
      "title": "Reversal Tests",
      "type": "array"
    },
    "run_id": {
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "title": "Run Id",
      "type": "string"
    },
    "scenario_id": {
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_manifests": {
      "items": {
        "$ref": "#/$defs/SourceManifest"
      },
      "minItems": 1,
      "title": "Source Manifests",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/RunStatus"
    },
    "value_of_information": {
      "items": {
        "$ref": "#/$defs/ValueOfInformation"
      },
      "title": "Value Of Information",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "scenario_id",
    "created_at",
    "status",
    "source_manifests",
    "evidence",
    "recommendation",
    "reproducibility"
  ],
  "title": "DecisionPack",
  "type": "object"
}
