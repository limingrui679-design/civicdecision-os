{
  "$defs": {
    "EvidenceType": {
      "enum": [
        "observed",
        "estimated",
        "causal",
        "simulated",
        "optimized",
        "proposed"
      ],
      "title": "EvidenceType",
      "type": "string"
    },
    "ForecastCandidate": {
      "additionalProperties": false,
      "properties": {
        "conformal_radius": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conformal Radius"
        },
        "eligible": {
          "title": "Eligible",
          "type": "boolean"
        },
        "exclusion_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exclusion Reason"
        },
        "folds": {
          "items": {
            "$ref": "#/$defs/ForecastFold"
          },
          "title": "Folds",
          "type": "array"
        },
        "method": {
          "$ref": "#/$defs/ForecastMethod"
        },
        "metrics": {
          "anyOf": [
            {
              "$ref": "#/$defs/ForecastMetrics"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "method",
        "eligible"
      ],
      "title": "ForecastCandidate",
      "type": "object"
    },
    "ForecastConfig": {
      "additionalProperties": false,
      "properties": {
        "backtest_folds": {
          "default": 8,
          "maximum": 100,
          "minimum": 1,
          "title": "Backtest Folds",
          "type": "integer"
        },
        "horizon": {
          "default": 7,
          "maximum": 366,
          "minimum": 1,
          "title": "Horizon",
          "type": "integer"
        },
        "interval_level": {
          "default": 0.9,
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0.5,
          "title": "Interval Level",
          "type": "number"
        },
        "methods": {
          "items": {
            "$ref": "#/$defs/ForecastMethod"
          },
          "minItems": 1,
          "title": "Methods",
          "type": "array"
        },
        "minimum_backtest_folds": {
          "default": 3,
          "maximum": 100,
          "minimum": 1,
          "title": "Minimum Backtest Folds",
          "type": "integer"
        },
        "minimum_train_size": {
          "default": 14,
          "maximum": 100000,
          "minimum": 2,
          "title": "Minimum Train Size",
          "type": "integer"
        },
        "moving_average_window": {
          "default": 7,
          "maximum": 366,
          "minimum": 2,
          "title": "Moving Average Window",
          "type": "integer"
        },
        "require_nonnegative": {
          "default": true,
          "title": "Require Nonnegative",
          "type": "boolean"
        },
        "seasonal_period": {
          "default": 7,
          "maximum": 366,
          "minimum": 2,
          "title": "Seasonal Period",
          "type": "integer"
        }
      },
      "title": "ForecastConfig",
      "type": "object"
    },
    "ForecastFold": {
      "additionalProperties": false,
      "properties": {
        "absolute_errors": {
          "items": {
            "type": "number"
          },
          "minItems": 1,
          "title": "Absolute Errors",
          "type": "array"
        },
        "actual": {
          "items": {
            "type": "number"
          },
          "minItems": 1,
          "title": "Actual",
          "type": "array"
        },
        "origin_timestamp": {
          "format": "date-time",
          "title": "Origin Timestamp",
          "type": "string"
        },
        "predicted": {
          "items": {
            "type": "number"
          },
          "minItems": 1,
          "title": "Predicted",
          "type": "array"
        },
        "target_timestamps": {
          "items": {
            "format": "date-time",
            "type": "string"
          },
          "minItems": 1,
          "title": "Target Timestamps",
          "type": "array"
        }
      },
      "required": [
        "origin_timestamp",
        "target_timestamps",
        "actual",
        "predicted",
        "absolute_errors"
      ],
      "title": "ForecastFold",
      "type": "object"
    },
    "ForecastMethod": {
      "enum": [
        "naive",
        "drift",
        "moving-average",
        "seasonal-naive"
      ],
      "title": "ForecastMethod",
      "type": "string"
    },
    "ForecastMetrics": {
      "additionalProperties": false,
      "properties": {
        "bias": {
          "title": "Bias",
          "type": "number"
        },
        "empirical_interval_coverage": {
          "maximum": 1,
          "minimum": 0,
          "title": "Empirical Interval Coverage",
          "type": "number"
        },
        "mae": {
          "minimum": 0,
          "title": "Mae",
          "type": "number"
        },
        "mean_interval_width": {
          "minimum": 0,
          "title": "Mean Interval Width",
          "type": "number"
        },
        "observations": {
          "minimum": 1,
          "title": "Observations",
          "type": "integer"
        },
        "rmse": {
          "minimum": 0,
          "title": "Rmse",
          "type": "number"
        },
        "wape": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wape"
        }
      },
      "required": [
        "observations",
        "mae",
        "rmse",
        "bias",
        "empirical_interval_coverage",
        "mean_interval_width"
      ],
      "title": "ForecastMetrics",
      "type": "object"
    },
    "ForecastRun": {
      "additionalProperties": false,
      "properties": {
        "candidates": {
          "items": {
            "$ref": "#/$defs/ForecastCandidate"
          },
          "minItems": 1,
          "title": "Candidates",
          "type": "array"
        },
        "config": {
          "$ref": "#/$defs/ForecastConfig"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "data_cutoff": {
          "format": "date-time",
          "title": "Data Cutoff",
          "type": "string"
        },
        "diagnostics": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Diagnostics",
          "type": "array"
        },
        "evidence_type": {
          "$ref": "#/$defs/EvidenceType",
          "default": "estimated"
        },
        "failure_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Reason"
        },
        "forecast": {
          "items": {
            "$ref": "#/$defs/ForecastValue"
          },
          "title": "Forecast",
          "type": "array"
        },
        "interval_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval Seconds"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "observation_count": {
          "minimum": 0,
          "title": "Observation Count",
          "type": "integer"
        },
        "run_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "selected_method": {
          "anyOf": [
            {
              "$ref": "#/$defs/ForecastMethod"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "series_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Series Id",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/ForecastStatus"
        }
      },
      "required": [
        "run_id",
        "series_id",
        "created_at",
        "data_cutoff",
        "source_refs",
        "status",
        "config",
        "observation_count",
        "candidates",
        "diagnostics",
        "limitations"
      ],
      "title": "ForecastRun",
      "type": "object"
    },
    "ForecastStatus": {
      "enum": [
        "completed",
        "insufficient-evidence"
      ],
      "title": "ForecastStatus",
      "type": "string"
    },
    "ForecastValue": {
      "additionalProperties": false,
      "properties": {
        "lower": {
          "title": "Lower",
          "type": "number"
        },
        "point": {
          "title": "Point",
          "type": "number"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "upper": {
          "title": "Upper",
          "type": "number"
        }
      },
      "required": [
        "timestamp",
        "point",
        "lower",
        "upper"
      ],
      "title": "ForecastValue",
      "type": "object"
    },
    "ReplayStatus": {
      "enum": [
        "completed",
        "insufficient-evidence"
      ],
      "title": "ReplayStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actual": {
      "items": {
        "type": "number"
      },
      "minItems": 1,
      "title": "Actual",
      "type": "array"
    },
    "city_id": {
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "title": "City Id",
      "type": "string"
    },
    "city_name": {
      "minLength": 1,
      "title": "City Name",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "data_cutoff": {
      "format": "date-time",
      "title": "Data Cutoff",
      "type": "string"
    },
    "diagnostics": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Diagnostics",
      "type": "array"
    },
    "empirical_interval_coverage": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Empirical Interval Coverage"
    },
    "evaluation_end": {
      "format": "date-time",
      "title": "Evaluation End",
      "type": "string"
    },
    "evaluation_mae": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evaluation Mae"
    },
    "evaluation_rmse": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evaluation Rmse"
    },
    "evaluation_start": {
      "format": "date-time",
      "title": "Evaluation Start",
      "type": "string"
    },
    "evaluation_wape": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evaluation Wape"
    },
    "forecast_run": {
      "$ref": "#/$defs/ForecastRun"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Limitations",
      "type": "array"
    },
    "parameter": {
      "pattern": "^[A-Z0-9_]+$",
      "title": "Parameter",
      "type": "string"
    },
    "replay_id": {
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "title": "Replay Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_method": {
      "anyOf": [
        {
          "$ref": "#/$defs/ForecastMethod"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "source_artifact_id": {
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "title": "Source Artifact Id",
      "type": "string"
    },
    "source_content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Source Content Hash",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ReplayStatus"
    },
    "train_start": {
      "format": "date-time",
      "title": "Train Start",
      "type": "string"
    }
  },
  "required": [
    "replay_id",
    "created_at",
    "city_id",
    "city_name",
    "source_artifact_id",
    "source_content_hash",
    "parameter",
    "train_start",
    "data_cutoff",
    "evaluation_start",
    "evaluation_end",
    "actual",
    "forecast_run",
    "status",
    "diagnostics",
    "limitations"
  ],
  "title": "HistoricalReplay",
  "type": "object"
}
