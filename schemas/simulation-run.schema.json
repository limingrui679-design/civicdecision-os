{
  "$defs": {
    "DistributionKind": {
      "enum": [
        "fixed",
        "uniform",
        "triangular",
        "normal",
        "bernoulli",
        "empirical"
      ],
      "title": "DistributionKind",
      "type": "string"
    },
    "EvidenceType": {
      "enum": [
        "observed",
        "estimated",
        "causal",
        "simulated",
        "optimized",
        "proposed"
      ],
      "title": "EvidenceType",
      "type": "string"
    },
    "ParameterDistribution": {
      "additionalProperties": false,
      "properties": {
        "assumptions": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Assumptions",
          "type": "array"
        },
        "empirical_values": {
          "items": {
            "type": "number"
          },
          "title": "Empirical Values",
          "type": "array"
        },
        "evidence_type": {
          "$ref": "#/$defs/EvidenceType"
        },
        "fixed_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fixed Value"
        },
        "kind": {
          "$ref": "#/$defs/DistributionKind"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "mode": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mode"
        },
        "parameter_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Parameter Id",
          "type": "string"
        },
        "probability": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Probability"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "standard_deviation": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Standard Deviation"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "parameter_id",
        "unit",
        "kind",
        "evidence_type",
        "assumptions",
        "limitations"
      ],
      "title": "ParameterDistribution",
      "type": "object"
    },
    "QuantileEstimate": {
      "additionalProperties": false,
      "properties": {
        "probability": {
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Probability",
          "type": "number"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "probability",
        "value"
      ],
      "title": "QuantileEstimate",
      "type": "object"
    },
    "RetainedSimulationDraw": {
      "additionalProperties": false,
      "properties": {
        "iteration": {
          "minimum": 0,
          "title": "Iteration",
          "type": "integer"
        },
        "outcome": {
          "title": "Outcome",
          "type": "number"
        },
        "parameters": {
          "additionalProperties": {
            "type": "number"
          },
          "minProperties": 1,
          "title": "Parameters",
          "type": "object"
        }
      },
      "required": [
        "iteration",
        "parameters",
        "outcome"
      ],
      "title": "RetainedSimulationDraw",
      "type": "object"
    },
    "SensitivityEstimate": {
      "additionalProperties": false,
      "properties": {
        "absolute_rank": {
          "minimum": 1,
          "title": "Absolute Rank",
          "type": "integer"
        },
        "method": {
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "parameter_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Parameter Id",
          "type": "string"
        },
        "pearson_correlation": {
          "maximum": 1,
          "minimum": -1,
          "title": "Pearson Correlation",
          "type": "number"
        }
      },
      "required": [
        "parameter_id",
        "pearson_correlation",
        "absolute_rank",
        "method"
      ],
      "title": "SensitivityEstimate",
      "type": "object"
    },
    "SimulationConfig": {
      "additionalProperties": false,
      "properties": {
        "iterations": {
          "default": 10000,
          "maximum": 1000000,
          "minimum": 100,
          "title": "Iterations",
          "type": "integer"
        },
        "quantiles": {
          "items": {
            "type": "number"
          },
          "title": "Quantiles",
          "type": "array"
        },
        "random_seed": {
          "default": 20260812,
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Random Seed",
          "type": "integer"
        },
        "retained_draws": {
          "default": 25,
          "maximum": 1000,
          "minimum": 0,
          "title": "Retained Draws",
          "type": "integer"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        },
        "threshold_direction": {
          "$ref": "#/$defs/ThresholdDirection",
          "default": "at-least"
        }
      },
      "title": "SimulationConfig",
      "type": "object"
    },
    "SimulationModel": {
      "additionalProperties": false,
      "properties": {
        "assumptions": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Assumptions",
          "type": "array"
        },
        "ceiling": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ceiling"
        },
        "floor": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Floor"
        },
        "intercept": {
          "title": "Intercept",
          "type": "number"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "method": {
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "model_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Model Id",
          "type": "string"
        },
        "outcome_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Outcome Id",
          "type": "string"
        },
        "outcome_unit": {
          "minLength": 1,
          "title": "Outcome Unit",
          "type": "string"
        },
        "scenario_ref": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Scenario Ref",
          "type": "string"
        },
        "terms": {
          "items": {
            "$ref": "#/$defs/SimulationTerm"
          },
          "minItems": 1,
          "title": "Terms",
          "type": "array"
        }
      },
      "required": [
        "model_id",
        "scenario_ref",
        "outcome_id",
        "outcome_unit",
        "intercept",
        "terms",
        "method",
        "assumptions",
        "limitations"
      ],
      "title": "SimulationModel",
      "type": "object"
    },
    "SimulationStatus": {
      "enum": [
        "completed",
        "insufficient-evidence"
      ],
      "title": "SimulationStatus",
      "type": "string"
    },
    "SimulationSummary": {
      "additionalProperties": false,
      "properties": {
        "maximum": {
          "title": "Maximum",
          "type": "number"
        },
        "mean": {
          "title": "Mean",
          "type": "number"
        },
        "minimum": {
          "title": "Minimum",
          "type": "number"
        },
        "quantiles": {
          "items": {
            "$ref": "#/$defs/QuantileEstimate"
          },
          "minItems": 1,
          "title": "Quantiles",
          "type": "array"
        },
        "standard_deviation": {
          "minimum": 0,
          "title": "Standard Deviation",
          "type": "number"
        },
        "threshold_probability": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold Probability"
        }
      },
      "required": [
        "mean",
        "standard_deviation",
        "minimum",
        "maximum",
        "quantiles"
      ],
      "title": "SimulationSummary",
      "type": "object"
    },
    "SimulationTerm": {
      "additionalProperties": false,
      "properties": {
        "coefficient": {
          "title": "Coefficient",
          "type": "number"
        },
        "parameter_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Parameter Id",
          "type": "string"
        }
      },
      "required": [
        "parameter_id",
        "coefficient"
      ],
      "title": "SimulationTerm",
      "type": "object"
    },
    "ThresholdDirection": {
      "enum": [
        "at-least",
        "at-most"
      ],
      "title": "ThresholdDirection",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "config": {
      "$ref": "#/$defs/SimulationConfig"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "diagnostics": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Diagnostics",
      "type": "array"
    },
    "draw_stream_hash": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Draw Stream Hash"
    },
    "evidence_type": {
      "$ref": "#/$defs/EvidenceType",
      "default": "simulated"
    },
    "failure_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Reason"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Limitations",
      "type": "array"
    },
    "model": {
      "$ref": "#/$defs/SimulationModel"
    },
    "parameters": {
      "items": {
        "$ref": "#/$defs/ParameterDistribution"
      },
      "minItems": 1,
      "title": "Parameters",
      "type": "array"
    },
    "retained_draws": {
      "items": {
        "$ref": "#/$defs/RetainedSimulationDraw"
      },
      "title": "Retained Draws",
      "type": "array"
    },
    "run_id": {
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sensitivity": {
      "items": {
        "$ref": "#/$defs/SensitivityEstimate"
      },
      "title": "Sensitivity",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/SimulationStatus"
    },
    "summary": {
      "anyOf": [
        {
          "$ref": "#/$defs/SimulationSummary"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "run_id",
    "created_at",
    "status",
    "model",
    "config",
    "parameters",
    "diagnostics",
    "limitations"
  ],
  "title": "SimulationRun",
  "type": "object"
}
