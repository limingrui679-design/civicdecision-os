{
  "$defs": {
    "CausalDiagnostic": {
      "additionalProperties": false,
      "properties": {
        "details": {
          "minLength": 1,
          "title": "Details",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "measured": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            }
          ],
          "title": "Measured"
        },
        "method": {
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/DiagnosticStatus"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            }
          ],
          "title": "Threshold"
        }
      },
      "required": [
        "id",
        "status",
        "measured",
        "threshold",
        "method",
        "details"
      ],
      "title": "CausalDiagnostic",
      "type": "object"
    },
    "CausalRunStatus": {
      "enum": [
        "identification-passed",
        "insufficient-evidence"
      ],
      "title": "CausalRunStatus",
      "type": "string"
    },
    "DiagnosticStatus": {
      "enum": [
        "pass",
        "fail"
      ],
      "title": "DiagnosticStatus",
      "type": "string"
    },
    "DifferenceInDifferencesConfig": {
      "additionalProperties": false,
      "properties": {
        "confidence_level": {
          "default": 0.95,
          "exclusiveMaximum": 0.999,
          "exclusiveMinimum": 0.5,
          "title": "Confidence Level",
          "type": "number"
        },
        "intervention_period": {
          "title": "Intervention Period",
          "type": "integer"
        },
        "minimum_post_periods": {
          "default": 2,
          "maximum": 10000,
          "minimum": 1,
          "title": "Minimum Post Periods",
          "type": "integer"
        },
        "minimum_pre_periods": {
          "default": 4,
          "maximum": 10000,
          "minimum": 3,
          "title": "Minimum Pre Periods",
          "type": "integer"
        },
        "minimum_units_per_group": {
          "default": 5,
          "maximum": 1000000,
          "minimum": 2,
          "title": "Minimum Units Per Group",
          "type": "integer"
        },
        "placebo_effect_equivalence_margin": {
          "exclusiveMinimum": 0,
          "title": "Placebo Effect Equivalence Margin",
          "type": "number"
        },
        "pretrend_slope_equivalence_margin": {
          "exclusiveMinimum": 0,
          "title": "Pretrend Slope Equivalence Margin",
          "type": "number"
        },
        "require_balanced_panel": {
          "default": true,
          "title": "Require Balanced Panel",
          "type": "boolean"
        }
      },
      "required": [
        "intervention_period",
        "pretrend_slope_equivalence_margin",
        "placebo_effect_equivalence_margin"
      ],
      "title": "DifferenceInDifferencesConfig",
      "type": "object"
    },
    "DifferenceInDifferencesDesign": {
      "additionalProperties": false,
      "properties": {
        "assignment_mechanism": {
          "minLength": 1,
          "title": "Assignment Mechanism",
          "type": "string"
        },
        "comparison_definition": {
          "minLength": 1,
          "title": "Comparison Definition",
          "type": "string"
        },
        "estimand": {
          "minLength": 1,
          "title": "Estimand",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "no_anticipation_rationale": {
          "minLength": 1,
          "title": "No Anticipation Rationale",
          "type": "string"
        },
        "no_interference_rationale": {
          "minLength": 1,
          "title": "No Interference Rationale",
          "type": "string"
        },
        "parallel_trends_rationale": {
          "minLength": 1,
          "title": "Parallel Trends Rationale",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        },
        "study_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Study Id",
          "type": "string"
        },
        "treatment_definition": {
          "minLength": 1,
          "title": "Treatment Definition",
          "type": "string"
        }
      },
      "required": [
        "study_id",
        "estimand",
        "treatment_definition",
        "comparison_definition",
        "assignment_mechanism",
        "no_anticipation_rationale",
        "parallel_trends_rationale",
        "no_interference_rationale",
        "source_refs",
        "limitations"
      ],
      "title": "DifferenceInDifferencesDesign",
      "type": "object"
    },
    "EffectEstimate": {
      "additionalProperties": false,
      "properties": {
        "comparison_units": {
          "minimum": 2,
          "title": "Comparison Units",
          "type": "integer"
        },
        "confidence_level": {
          "exclusiveMaximum": 0.999,
          "exclusiveMinimum": 0.5,
          "title": "Confidence Level",
          "type": "number"
        },
        "estimate": {
          "title": "Estimate",
          "type": "number"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "lower": {
          "title": "Lower",
          "type": "number"
        },
        "p_value": {
          "maximum": 1,
          "minimum": 0,
          "title": "P Value",
          "type": "number"
        },
        "standard_error": {
          "minimum": 0,
          "title": "Standard Error",
          "type": "number"
        },
        "treated_units": {
          "minimum": 2,
          "title": "Treated Units",
          "type": "integer"
        },
        "upper": {
          "title": "Upper",
          "type": "number"
        }
      },
      "required": [
        "label",
        "estimate",
        "standard_error",
        "confidence_level",
        "lower",
        "upper",
        "p_value",
        "treated_units",
        "comparison_units"
      ],
      "title": "EffectEstimate",
      "type": "object"
    },
    "EventTimeEffect": {
      "additionalProperties": false,
      "properties": {
        "calendar_period": {
          "title": "Calendar Period",
          "type": "integer"
        },
        "estimate": {
          "$ref": "#/$defs/EffectEstimate"
        },
        "relative_period": {
          "title": "Relative Period",
          "type": "integer"
        }
      },
      "required": [
        "relative_period",
        "calendar_period",
        "estimate"
      ],
      "title": "EventTimeEffect",
      "type": "object"
    },
    "EvidenceType": {
      "enum": [
        "observed",
        "estimated",
        "causal",
        "simulated",
        "optimized",
        "proposed"
      ],
      "title": "EvidenceType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "causal_claim_issued": {
      "title": "Causal Claim Issued",
      "type": "boolean"
    },
    "config": {
      "$ref": "#/$defs/DifferenceInDifferencesConfig"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "data_cutoff_period": {
      "title": "Data Cutoff Period",
      "type": "integer"
    },
    "design": {
      "$ref": "#/$defs/DifferenceInDifferencesDesign"
    },
    "diagnostics": {
      "items": {
        "$ref": "#/$defs/CausalDiagnostic"
      },
      "minItems": 1,
      "title": "Diagnostics",
      "type": "array"
    },
    "event_time_effects": {
      "items": {
        "$ref": "#/$defs/EventTimeEffect"
      },
      "title": "Event Time Effects",
      "type": "array"
    },
    "evidence_type": {
      "$ref": "#/$defs/EvidenceType"
    },
    "failure_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Reason"
    },
    "interpretation": {
      "minLength": 1,
      "title": "Interpretation",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Limitations",
      "type": "array"
    },
    "observation_count": {
      "minimum": 0,
      "title": "Observation Count",
      "type": "integer"
    },
    "placebo_effects": {
      "items": {
        "$ref": "#/$defs/EventTimeEffect"
      },
      "title": "Placebo Effects",
      "type": "array"
    },
    "post_periods": {
      "items": {
        "type": "integer"
      },
      "title": "Post Periods",
      "type": "array"
    },
    "pre_periods": {
      "items": {
        "type": "integer"
      },
      "title": "Pre Periods",
      "type": "array"
    },
    "primary_effect": {
      "anyOf": [
        {
          "$ref": "#/$defs/EffectEstimate"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "run_id": {
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/CausalRunStatus"
    },
    "unit_count": {
      "minimum": 0,
      "title": "Unit Count",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "created_at",
    "data_cutoff_period",
    "status",
    "evidence_type",
    "causal_claim_issued",
    "design",
    "config",
    "observation_count",
    "unit_count",
    "pre_periods",
    "post_periods",
    "diagnostics",
    "interpretation",
    "limitations"
  ],
  "title": "DifferenceInDifferencesRun",
  "type": "object"
}
