{
  "$defs": {
    "DecisionReversal": {
      "additionalProperties": false,
      "properties": {
        "baseline_option_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Baseline Option Id",
          "type": "string"
        },
        "competing_option_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Competing Option Id",
          "type": "string"
        },
        "condition": {
          "minLength": 1,
          "title": "Condition",
          "type": "string"
        },
        "first_reversal_draw": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Reversal Draw"
        },
        "reversal_probability": {
          "maximum": 1,
          "minimum": 0,
          "title": "Reversal Probability",
          "type": "number"
        }
      },
      "required": [
        "baseline_option_id",
        "competing_option_id",
        "reversal_probability",
        "condition"
      ],
      "title": "DecisionReversal",
      "type": "object"
    },
    "EvidenceType": {
      "enum": [
        "observed",
        "estimated",
        "causal",
        "simulated",
        "optimized",
        "proposed"
      ],
      "title": "EvidenceType",
      "type": "string"
    },
    "ObjectiveSense": {
      "enum": [
        "maximize",
        "minimize"
      ],
      "title": "ObjectiveSense",
      "type": "string"
    },
    "OptionUncertaintySummary": {
      "additionalProperties": false,
      "properties": {
        "dominated_probability": {
          "maximum": 1,
          "minimum": 0,
          "title": "Dominated Probability",
          "type": "number"
        },
        "draws": {
          "minimum": 2,
          "title": "Draws",
          "type": "integer"
        },
        "expected_regret": {
          "minimum": 0,
          "title": "Expected Regret",
          "type": "number"
        },
        "lower": {
          "title": "Lower",
          "type": "number"
        },
        "maximum_regret": {
          "minimum": 0,
          "title": "Maximum Regret",
          "type": "number"
        },
        "mean": {
          "title": "Mean",
          "type": "number"
        },
        "option_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Option Id",
          "type": "string"
        },
        "probability_best": {
          "maximum": 1,
          "minimum": 0,
          "title": "Probability Best",
          "type": "number"
        },
        "standard_deviation": {
          "minimum": 0,
          "title": "Standard Deviation",
          "type": "number"
        },
        "upper": {
          "title": "Upper",
          "type": "number"
        }
      },
      "required": [
        "option_id",
        "draws",
        "mean",
        "standard_deviation",
        "lower",
        "upper",
        "probability_best",
        "expected_regret",
        "maximum_regret",
        "dominated_probability"
      ],
      "title": "OptionUncertaintySummary",
      "type": "object"
    },
    "PairwiseDominance": {
      "additionalProperties": false,
      "properties": {
        "mean_difference_in_better_direction": {
          "title": "Mean Difference In Better Direction",
          "type": "number"
        },
        "option_a": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Option A",
          "type": "string"
        },
        "option_b": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Option B",
          "type": "string"
        },
        "practical_margin": {
          "minimum": 0,
          "title": "Practical Margin",
          "type": "number"
        },
        "probability_a_better": {
          "maximum": 1,
          "minimum": 0,
          "title": "Probability A Better",
          "type": "number"
        }
      },
      "required": [
        "option_a",
        "option_b",
        "probability_a_better",
        "mean_difference_in_better_direction",
        "practical_margin"
      ],
      "title": "PairwiseDominance",
      "type": "object"
    },
    "UncertaintyConfig": {
      "additionalProperties": false,
      "properties": {
        "confidence_level": {
          "default": 0.95,
          "exclusiveMaximum": 0.999,
          "exclusiveMinimum": 0.5,
          "title": "Confidence Level",
          "type": "number"
        },
        "maximum_expected_regret": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Expected Regret"
        },
        "practical_equivalence_margin": {
          "default": 0,
          "minimum": 0,
          "title": "Practical Equivalence Margin",
          "type": "number"
        },
        "require_paired_draws": {
          "default": true,
          "title": "Require Paired Draws",
          "type": "boolean"
        },
        "robust_probability_threshold": {
          "default": 0.9,
          "exclusiveMinimum": 0.5,
          "maximum": 1,
          "title": "Robust Probability Threshold",
          "type": "number"
        },
        "sense": {
          "$ref": "#/$defs/ObjectiveSense"
        }
      },
      "required": [
        "sense"
      ],
      "title": "UncertaintyConfig",
      "type": "object"
    },
    "UncertaintyMethod": {
      "enum": [
        "paired-draws",
        "independent-summaries"
      ],
      "title": "UncertaintyMethod",
      "type": "string"
    },
    "UncertaintyStatus": {
      "enum": [
        "robust-winner",
        "reversal-risk",
        "insufficient-evidence"
      ],
      "title": "UncertaintyStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "baseline_option_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Baseline Option Id"
    },
    "config": {
      "$ref": "#/$defs/UncertaintyConfig"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "diagnostics": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Diagnostics",
      "type": "array"
    },
    "evidence_type": {
      "$ref": "#/$defs/EvidenceType"
    },
    "failure_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Reason"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Limitations",
      "type": "array"
    },
    "method": {
      "$ref": "#/$defs/UncertaintyMethod"
    },
    "option_summaries": {
      "items": {
        "$ref": "#/$defs/OptionUncertaintySummary"
      },
      "title": "Option Summaries",
      "type": "array"
    },
    "pairwise_dominance": {
      "items": {
        "$ref": "#/$defs/PairwiseDominance"
      },
      "title": "Pairwise Dominance",
      "type": "array"
    },
    "reversals": {
      "items": {
        "$ref": "#/$defs/DecisionReversal"
      },
      "title": "Reversals",
      "type": "array"
    },
    "run_id": {
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_option_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selected Option Id"
    },
    "status": {
      "$ref": "#/$defs/UncertaintyStatus"
    }
  },
  "required": [
    "run_id",
    "created_at",
    "status",
    "method",
    "evidence_type",
    "config",
    "option_summaries",
    "pairwise_dominance",
    "reversals",
    "diagnostics",
    "limitations"
  ],
  "title": "UncertaintyRun",
  "type": "object"
}
