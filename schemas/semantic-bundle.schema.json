{
  "$defs": {
    "Coordinate": {
      "additionalProperties": false,
      "properties": {
        "latitude": {
          "maximum": 90,
          "minimum": -90,
          "title": "Latitude",
          "type": "number"
        },
        "longitude": {
          "maximum": 180,
          "minimum": -180,
          "title": "Longitude",
          "type": "number"
        }
      },
      "required": [
        "latitude",
        "longitude"
      ],
      "title": "Coordinate",
      "type": "object"
    },
    "EventKind": {
      "enum": [
        "weather",
        "disaster",
        "service",
        "infrastructure",
        "policy",
        "other"
      ],
      "title": "EventKind",
      "type": "string"
    },
    "EvidenceType": {
      "enum": [
        "observed",
        "estimated",
        "causal",
        "simulated",
        "optimized",
        "proposed"
      ],
      "title": "EvidenceType",
      "type": "string"
    },
    "Facility": {
      "additionalProperties": false,
      "properties": {
        "capacity": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capacity"
        },
        "capacity_unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capacity Unit"
        },
        "geography_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Geography Id",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/FacilityKind"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/Coordinate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        },
        "status": {
          "minLength": 1,
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "geography_id",
        "status",
        "source_refs",
        "limitations"
      ],
      "title": "Facility",
      "type": "object"
    },
    "FacilityKind": {
      "enum": [
        "health",
        "shelter",
        "cooling",
        "education",
        "transit",
        "emergency",
        "utility",
        "other"
      ],
      "title": "FacilityKind",
      "type": "string"
    },
    "Geography": {
      "additionalProperties": false,
      "properties": {
        "centroid": {
          "anyOf": [
            {
              "$ref": "#/$defs/Coordinate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "codes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Codes",
          "type": "object"
        },
        "country_code": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Country Code"
        },
        "id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/GeographyKind"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "parent_ids": {
          "items": {
            "type": "string"
          },
          "title": "Parent Ids",
          "type": "array"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "source_refs",
        "limitations"
      ],
      "title": "Geography",
      "type": "object"
    },
    "GeographyKind": {
      "enum": [
        "country-or-territory",
        "region",
        "city",
        "administrative-area",
        "tract",
        "point"
      ],
      "title": "GeographyKind",
      "type": "string"
    },
    "JsonValue": {},
    "MeasureDefinition": {
      "additionalProperties": false,
      "properties": {
        "denominator_measure_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Denominator Measure Id"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "numerator_measure_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numerator Measure Id"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "valid_max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Max"
        },
        "valid_min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Min"
        },
        "value_kind": {
          "$ref": "#/$defs/MeasureValueKind"
        }
      },
      "required": [
        "id",
        "name",
        "value_kind",
        "unit",
        "description",
        "limitations"
      ],
      "title": "MeasureDefinition",
      "type": "object"
    },
    "MeasureValueKind": {
      "enum": [
        "count",
        "rate",
        "index",
        "currency",
        "temperature",
        "distance",
        "duration",
        "boolean",
        "category",
        "other"
      ],
      "title": "MeasureValueKind",
      "type": "string"
    },
    "Observation": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Attributes",
          "type": "object"
        },
        "evidence_type": {
          "$ref": "#/$defs/EvidenceType"
        },
        "geography_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Geography Id",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "interval": {
          "$ref": "#/$defs/TimeInterval"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "measure_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Measure Id",
          "type": "string"
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        },
        "quality_flags": {
          "items": {
            "type": "string"
          },
          "title": "Quality Flags",
          "type": "array"
        },
        "source_ref": {
          "minLength": 1,
          "title": "Source Ref",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "id",
        "geography_id",
        "measure_id",
        "interval",
        "value",
        "evidence_type",
        "source_ref",
        "limitations"
      ],
      "title": "Observation",
      "type": "object"
    },
    "SourceManifest": {
      "additionalProperties": false,
      "description": "Evidence required to identify and independently verify a downloaded artifact.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_path": {
          "minLength": 1,
          "title": "Artifact Path",
          "type": "string"
        },
        "content_hash": {
          "title": "Content Hash",
          "type": "string"
        },
        "data_url": {
          "format": "uri",
          "minLength": 1,
          "title": "Data Url",
          "type": "string"
        },
        "geographic_scope": {
          "minLength": 1,
          "title": "Geographic Scope",
          "type": "string"
        },
        "landing_url": {
          "format": "uri",
          "minLength": 1,
          "title": "Landing Url",
          "type": "string"
        },
        "license": {
          "minLength": 1,
          "title": "License",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "publisher": {
          "minLength": 1,
          "title": "Publisher",
          "type": "string"
        },
        "query": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Query",
          "type": "object"
        },
        "record_count": {
          "minimum": 0,
          "title": "Record Count",
          "type": "integer"
        },
        "response_headers": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Response Headers",
          "type": "object"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "schema_fingerprint": {
          "title": "Schema Fingerprint",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Source Id",
          "type": "string"
        },
        "temporal_scope": {
          "minLength": 1,
          "title": "Temporal Scope",
          "type": "string"
        },
        "upstream_updated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upstream Updated At"
        }
      },
      "required": [
        "source_id",
        "artifact_id",
        "name",
        "publisher",
        "landing_url",
        "data_url",
        "license",
        "retrieved_at",
        "query",
        "artifact_path",
        "content_hash",
        "record_count",
        "schema_fingerprint",
        "geographic_scope",
        "temporal_scope",
        "limitations"
      ],
      "title": "SourceManifest",
      "type": "object"
    },
    "TimeInterval": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "resolution": {
          "minLength": 1,
          "title": "Resolution",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "resolution"
      ],
      "title": "TimeInterval",
      "type": "object"
    },
    "UrbanEvent": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Attributes",
          "type": "object"
        },
        "evidence_type": {
          "$ref": "#/$defs/EvidenceType"
        },
        "geography_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Geography Ids",
          "type": "array"
        },
        "id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "interval": {
          "$ref": "#/$defs/TimeInterval"
        },
        "kind": {
          "$ref": "#/$defs/EventKind"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "interval",
        "geography_ids",
        "evidence_type",
        "source_refs",
        "limitations"
      ],
      "title": "UrbanEvent",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "bundle_id": {
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "title": "Bundle Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/UrbanEvent"
      },
      "title": "Events",
      "type": "array"
    },
    "facilities": {
      "items": {
        "$ref": "#/$defs/Facility"
      },
      "title": "Facilities",
      "type": "array"
    },
    "geographies": {
      "items": {
        "$ref": "#/$defs/Geography"
      },
      "minItems": 1,
      "title": "Geographies",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Limitations",
      "type": "array"
    },
    "measures": {
      "items": {
        "$ref": "#/$defs/MeasureDefinition"
      },
      "title": "Measures",
      "type": "array"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/Observation"
      },
      "title": "Observations",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_manifests": {
      "items": {
        "$ref": "#/$defs/SourceManifest"
      },
      "minItems": 1,
      "title": "Source Manifests",
      "type": "array"
    }
  },
  "required": [
    "bundle_id",
    "created_at",
    "source_manifests",
    "geographies",
    "limitations"
  ],
  "title": "SemanticBundle",
  "type": "object"
}
