{
  "$defs": {
    "AnalysisMode": {
      "enum": [
        "descriptive",
        "forecast",
        "causal",
        "simulation",
        "optimization"
      ],
      "title": "AnalysisMode",
      "type": "string"
    },
    "Constraint": {
      "additionalProperties": false,
      "properties": {
        "expression": {
          "minLength": 1,
          "title": "Expression",
          "type": "string"
        },
        "hard": {
          "default": true,
          "title": "Hard",
          "type": "boolean"
        },
        "id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^(budget|capacity|equity|risk|time|regulatory|custom)$",
          "title": "Kind",
          "type": "string"
        },
        "source_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Ref"
        }
      },
      "required": [
        "id",
        "expression",
        "kind"
      ],
      "title": "Constraint",
      "type": "object"
    },
    "EvidenceType": {
      "enum": [
        "observed",
        "estimated",
        "causal",
        "simulated",
        "optimized",
        "proposed"
      ],
      "title": "EvidenceType",
      "type": "string"
    },
    "Intervention": {
      "additionalProperties": false,
      "properties": {
        "evidence_type": {
          "$ref": "#/$defs/EvidenceType",
          "default": "proposed"
        },
        "id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Kind",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Parameters",
          "type": "object"
        },
        "target": {
          "minLength": 1,
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "target",
        "parameters"
      ],
      "title": "Intervention",
      "type": "object"
    },
    "JsonValue": {},
    "Objective": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "metric": {
          "minLength": 1,
          "title": "Metric",
          "type": "string"
        },
        "sense": {
          "pattern": "^(minimize|maximize)$",
          "title": "Sense",
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "weight": {
          "exclusiveMinimum": 0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "id",
        "metric",
        "sense",
        "weight",
        "unit"
      ],
      "title": "Objective",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "analysis_modes": {
      "items": {
        "$ref": "#/$defs/AnalysisMode"
      },
      "minItems": 1,
      "title": "Analysis Modes",
      "type": "array"
    },
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "assumptions": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Assumptions",
      "type": "array"
    },
    "baseline": {
      "minLength": 1,
      "title": "Baseline",
      "type": "string"
    },
    "city_id": {
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "title": "City Id",
      "type": "string"
    },
    "constraints": {
      "items": {
        "$ref": "#/$defs/Constraint"
      },
      "minItems": 1,
      "title": "Constraints",
      "type": "array"
    },
    "data_cutoff": {
      "format": "date-time",
      "title": "Data Cutoff",
      "type": "string"
    },
    "evidence_requirements": {
      "items": {
        "$ref": "#/$defs/EvidenceType"
      },
      "minItems": 1,
      "title": "Evidence Requirements",
      "type": "array"
    },
    "interventions": {
      "items": {
        "$ref": "#/$defs/Intervention"
      },
      "minItems": 1,
      "title": "Interventions",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Limitations",
      "type": "array"
    },
    "objectives": {
      "items": {
        "$ref": "#/$defs/Objective"
      },
      "minItems": 1,
      "title": "Objectives",
      "type": "array"
    },
    "question": {
      "minLength": 1,
      "title": "Question",
      "type": "string"
    },
    "random_seed": {
      "maximum": 4294967295,
      "minimum": 0,
      "title": "Random Seed",
      "type": "integer"
    },
    "scenario_id": {
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "scenario_id",
    "title",
    "question",
    "city_id",
    "as_of",
    "data_cutoff",
    "baseline",
    "interventions",
    "objectives",
    "constraints",
    "analysis_modes",
    "evidence_requirements",
    "random_seed",
    "assumptions",
    "limitations"
  ],
  "title": "PolicyScenario",
  "type": "object"
}
