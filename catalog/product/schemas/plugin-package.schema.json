{
  "$defs": {
    "BoundingBox": {
      "additionalProperties": false,
      "properties": {
        "east": {
          "maximum": 180,
          "minimum": -180,
          "title": "East",
          "type": "number"
        },
        "north": {
          "maximum": 90,
          "minimum": -90,
          "title": "North",
          "type": "number"
        },
        "south": {
          "maximum": 90,
          "minimum": -90,
          "title": "South",
          "type": "number"
        },
        "west": {
          "maximum": 180,
          "minimum": -180,
          "title": "West",
          "type": "number"
        }
      },
      "required": [
        "west",
        "south",
        "east",
        "north"
      ],
      "title": "BoundingBox",
      "type": "object"
    },
    "CityAdapterManifest": {
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "$ref": "#/$defs/BoundingBox"
        },
        "capabilities": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Capabilities",
          "type": "array"
        },
        "city_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "City Id",
          "type": "string"
        },
        "country_code": {
          "maxLength": 2,
          "minLength": 2,
          "title": "Country Code",
          "type": "string"
        },
        "coverage": {
          "anyOf": [
            {
              "$ref": "#/$defs/CoverageWindow"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "data_gaps": {
          "items": {
            "type": "string"
          },
          "title": "Data Gaps",
          "type": "array"
        },
        "display_name": {
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "tier": {
          "$ref": "#/$defs/CityTier"
        },
        "timezone": {
          "title": "Timezone",
          "type": "string"
        }
      },
      "required": [
        "city_id",
        "display_name",
        "country_code",
        "tier",
        "timezone",
        "bbox",
        "source_ids",
        "capabilities",
        "limitations"
      ],
      "title": "CityAdapterManifest",
      "type": "object"
    },
    "CityTier": {
      "enum": [
        "G",
        "S",
        "D"
      ],
      "title": "CityTier",
      "type": "string"
    },
    "CoverageWindow": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "CoverageWindow",
      "type": "object"
    },
    "PluginCapability": {
      "description": "Capabilities that may be declared without executing third-party code.",
      "enum": [
        "city-adapter",
        "source-binding",
        "semantic-mapping"
      ],
      "title": "PluginCapability",
      "type": "string"
    },
    "PluginManifest": {
      "additionalProperties": false,
      "description": "Signed-shape descriptor for one portable, data-only plugin directory.",
      "properties": {
        "adapter_paths": {
          "items": {
            "type": "string"
          },
          "maxItems": 250,
          "minItems": 1,
          "title": "Adapter Paths",
          "type": "array"
        },
        "api_version": {
          "const": "1",
          "default": "1",
          "title": "Api Version",
          "type": "string"
        },
        "artifact_hashes": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 250,
          "minProperties": 1,
          "title": "Artifact Hashes",
          "type": "object"
        },
        "author": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Author",
          "type": "string"
        },
        "capabilities": {
          "items": {
            "$ref": "#/$defs/PluginCapability"
          },
          "minItems": 1,
          "title": "Capabilities",
          "type": "array"
        },
        "description": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "enabled_by_default": {
          "const": false,
          "default": false,
          "title": "Enabled By Default",
          "type": "boolean"
        },
        "evidence_boundary": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Evidence Boundary",
          "type": "array"
        },
        "license": {
          "maxLength": 80,
          "minLength": 1,
          "title": "License",
          "type": "string"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "plugin_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Plugin Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "version": {
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:[-+][0-9A-Za-z.-]+)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "plugin_id",
        "name",
        "version",
        "description",
        "author",
        "license",
        "capabilities",
        "adapter_paths",
        "artifact_hashes",
        "evidence_boundary"
      ],
      "title": "PluginManifest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Validated in-memory projection of a plugin directory.",
  "properties": {
    "adapters": {
      "items": {
        "$ref": "#/$defs/CityAdapterManifest"
      },
      "maxItems": 250,
      "minItems": 1,
      "title": "Adapters",
      "type": "array"
    },
    "manifest": {
      "$ref": "#/$defs/PluginManifest"
    },
    "package_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Package Hash",
      "type": "string"
    }
  },
  "required": [
    "manifest",
    "adapters",
    "package_hash"
  ],
  "title": "PluginPackage",
  "type": "object"
}
