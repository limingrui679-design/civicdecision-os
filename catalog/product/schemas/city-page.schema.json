{
  "$defs": {
    "CitySummary": {
      "additionalProperties": false,
      "properties": {
        "city_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "City Id",
          "type": "string"
        },
        "completed_scenarios": {
          "minimum": 0,
          "title": "Completed Scenarios",
          "type": "integer"
        },
        "country_code": {
          "pattern": "^[A-Z]{2}$",
          "title": "Country Code",
          "type": "string"
        },
        "latitude": {
          "maximum": 90,
          "minimum": -90,
          "title": "Latitude",
          "type": "number"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "longitude": {
          "maximum": 180,
          "minimum": -180,
          "title": "Longitude",
          "type": "number"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "negative_scenarios": {
          "minimum": 0,
          "title": "Negative Scenarios",
          "type": "integer"
        },
        "quality_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quality Status"
        },
        "readiness": {
          "minLength": 1,
          "title": "Readiness",
          "type": "string"
        },
        "scenario_count": {
          "minimum": 0,
          "title": "Scenario Count",
          "type": "integer"
        },
        "source_artifact_count": {
          "minimum": 0,
          "title": "Source Artifact Count",
          "type": "integer"
        },
        "source_population": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Population"
        },
        "tier": {
          "$ref": "#/$defs/ProductTier"
        },
        "timezone": {
          "minLength": 1,
          "title": "Timezone",
          "type": "string"
        }
      },
      "required": [
        "city_id",
        "name",
        "country_code",
        "tier",
        "latitude",
        "longitude",
        "timezone",
        "source_artifact_count",
        "scenario_count",
        "completed_scenarios",
        "negative_scenarios",
        "readiness",
        "limitations"
      ],
      "title": "CitySummary",
      "type": "object"
    },
    "Pagination": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "next_offset": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Offset"
        },
        "offset": {
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "returned": {
          "minimum": 0,
          "title": "Returned",
          "type": "integer"
        },
        "total": {
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "total",
        "limit",
        "offset",
        "returned"
      ],
      "title": "Pagination",
      "type": "object"
    },
    "ProductTier": {
      "enum": [
        "G",
        "S",
        "D"
      ],
      "title": "ProductTier",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/CitySummary"
      },
      "title": "Items",
      "type": "array"
    },
    "pagination": {
      "$ref": "#/$defs/Pagination"
    }
  },
  "required": [
    "pagination",
    "items"
  ],
  "title": "CityPage",
  "type": "object"
}
