{
  "additionalProperties": false,
  "properties": {
    "byte_count": {
      "minimum": 1,
      "title": "Byte Count",
      "type": "integer"
    },
    "content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "media_type": {
      "minLength": 1,
      "title": "Media Type",
      "type": "string"
    },
    "path": {
      "pattern": "^[a-z0-9][a-z0-9._/-]*$",
      "title": "Path",
      "type": "string"
    },
    "record_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Record Count"
    }
  },
  "required": [
    "path",
    "media_type",
    "byte_count",
    "content_hash"
  ],
  "title": "ProductArtifactEntry",
  "type": "object"
}
