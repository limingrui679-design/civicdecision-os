{
  "$defs": {
    "DecisionType": {
      "enum": [
        "diagnose",
        "forecast",
        "prioritize",
        "site",
        "allocate",
        "schedule",
        "stress-test",
        "evaluate"
      ],
      "title": "DecisionType",
      "type": "string"
    },
    "Pagination": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "next_offset": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Offset"
        },
        "offset": {
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "returned": {
          "minimum": 0,
          "title": "Returned",
          "type": "integer"
        },
        "total": {
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "total",
        "limit",
        "offset",
        "returned"
      ],
      "title": "Pagination",
      "type": "object"
    },
    "ScenarioFamilySummary": {
      "additionalProperties": false,
      "properties": {
        "affected_system": {
          "minLength": 5,
          "title": "Affected System",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "decision_owner": {
          "minLength": 3,
          "title": "Decision Owner",
          "type": "string"
        },
        "decision_types": {
          "items": {
            "$ref": "#/$defs/DecisionType"
          },
          "minItems": 1,
          "title": "Decision Types",
          "type": "array"
        },
        "description": {
          "minLength": 12,
          "title": "Description",
          "type": "string"
        },
        "design_count": {
          "minimum": 1,
          "title": "Design Count",
          "type": "integer"
        },
        "design_only_count": {
          "minimum": 0,
          "title": "Design Only Count",
          "type": "integer"
        },
        "family_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Family Id",
          "type": "string"
        },
        "family_order": {
          "minimum": 1,
          "title": "Family Order",
          "type": "integer"
        },
        "reference_implemented_count": {
          "minimum": 0,
          "title": "Reference Implemented Count",
          "type": "integer"
        },
        "suite": {
          "minLength": 1,
          "title": "Suite",
          "type": "string"
        },
        "title": {
          "minLength": 3,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "family_order",
        "family_id",
        "suite",
        "title",
        "description",
        "affected_system",
        "decision_owner",
        "design_count",
        "reference_implemented_count",
        "design_only_count",
        "decision_types",
        "content_hash"
      ],
      "title": "ScenarioFamilySummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/ScenarioFamilySummary"
      },
      "title": "Items",
      "type": "array"
    },
    "pagination": {
      "$ref": "#/$defs/Pagination"
    }
  },
  "required": [
    "pagination",
    "items"
  ],
  "title": "ScenarioFamilyPage",
  "type": "object"
}
